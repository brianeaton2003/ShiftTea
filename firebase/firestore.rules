rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow reads for review documents regardless of parent path.
    // This is needed for `collectionGroup('reviews')` queries.
    match /{documentPath=**}/reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /user_reviews/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /app_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
