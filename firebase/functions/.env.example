# Copy to .env.local in THIS directory (firebase/functions/) — not in shifttea/.
# Firebase loads .env / .env.local here when the Functions emulator runs.
#
# Alternative: from repo root run `npm run dev:metrics` (sets the variable for the emulator process).
#
# When enabled AND the Functions emulator is running: each invocation logs reads/writes and appends
# JSON lines to firebase/functions/dev-metrics.jsonl — then run: npm run metrics:summary
SHIFTTEA_FIRESTORE_METRICS=1
